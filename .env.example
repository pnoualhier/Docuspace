# ==============================================================================
# DOCUSPACE — CONFIGURATION D'ENVIRONNEMENT COMPLÈTE (.env.example)
# ==============================================================================
# AVERTISSEMENT : Ce fichier ne doit contenir AUCUN secret réel.
# Sur Debian, exécutez ./scripts/init/generate_env.sh pour générer .env.
# ==============================================================================

# --- APPLICATION & DOMAINE ---
APP_NAME=DocuSpace
APP_ENV=production
APP_URL=https://docuspace.example.com
API_V1_STR=/api/v1
VITE_API_URL=/api/v1

# --- CRYPTOGRAPHIE & JETONS JWT (obligatoire : >= 32 caractères aléatoires) ---
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- PORTS PUBLICS NGINX UNIQUEMENT (PostgreSQL/Redis/MinIO/ClamAV non exposés) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- BASE DE DONNÉES POSTGRESQL (ISOLATION RLS) ---
POSTGRES_DB=docuspace
POSTGRES_USER=docuspace_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://docuspace_user:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/docuspace

# --- STOCKAGE D'OBJETS S3 / MINIO ---
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ADMIN_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_SECRET
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ADMIN_USER
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_SECRET
MINIO_BUCKET_NAME=docuspace-documents
MINIO_SECURE=false

# --- ANTIVIRUS FAIL-CLOSED (CLAMAV) ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=true

# --- CACHE & VERROUS (REDIS) ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0

# --- CORS ---
BACKEND_CORS_ORIGINS=["https://docuspace.example.com"]

# --- SERVICE EMAIL SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_TLS=true
EMAIL_VERIFICATION_REQUIRED=false

# --- SAUVEGARDES & RÉTENTION ---
BACKUP_DIR=/var/backups/docuspace
RETENTION_DAYS=14
