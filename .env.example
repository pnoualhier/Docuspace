# =========================================================================
# DocuSpace SaaS Environment Configuration Template
# Copy this file to .env and replace secrets with cryptographically secure values
# =========================================================================

# --- APP CONFIGURATION ---
APP_NAME="DocuSpace"
APP_ENV="production"
APP_URL="http://localhost"
SECRET_KEY="generate_with_openssl_rand_hex_32_change_me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- PORT BINDINGS ---
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
CLAMAV_PORT=3310
REDIS_PORT=6379

# --- POSTGRESQL MULTI-TENANT DATABASE ---
POSTGRES_DB=docuspace
POSTGRES_USER=docuspace_user
POSTGRES_PASSWORD=replace_with_strong_random_db_password
DATABASE_URL=postgresql+asyncpg://docuspace_user:replace_with_strong_random_db_password@postgres:5432/docuspace

# --- S3 / MINIO OBJECT STORAGE ---
MINIO_ROOT_USER=docuspace_minio_admin
MINIO_ROOT_PASSWORD=replace_with_strong_minio_secret_key
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=docuspace-documents
MINIO_SECURE=false

# --- ANTIVIRUS & SCANNER (CLAMAV) ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=true

# --- CACHE & BACKGROUND JOBS (REDIS) ---
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379/0

# --- SMTP EMAIL SERVICE ---
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=smtp_password_here
SMTP_FROM_EMAIL=no-reply@docuspace.io
SMTP_TLS=true

# --- BACKUP RETENTION ---
BACKUP_DIR=/var/backups/docuspace
RETENTION_DAYS=14
