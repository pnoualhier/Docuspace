# ==============================================================================
# DOCUSPACE — CONFIGURATION D'ENVIRONNEMENT SÉCURISÉE (.env.example)
# ==============================================================================
# AVERTISSEMENT : Ne jamais commiter de secrets réels dans les dépôts git.
# Générez des secrets forts en production via : openssl rand -hex 32

APP_NAME="DocuSpace"
APP_ENV="production"
APP_URL="https://docuspace.example.com"
API_V1_STR="/api/v1"

# --- CRYPTOGRAPHIE & JETONS JWT ---
# Obligatoire en production : clé aléatoire d'au moins 32 caractères
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- BASE DE DONNÉES POSTGRESQL ---
# Requiert l'utilisateur docuspace_user avec Row-Level Security (RLS) activé
DATABASE_URL="postgresql+asyncpg://docuspace_user:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/docuspace"

# --- STOCKAGE D'OBJETS S3 / MINIO ---
MINIO_ENDPOINT="minio:9000"
MINIO_ACCESS_KEY="REPLACE_WITH_MINIO_ACCESS_KEY"
MINIO_SECRET_KEY="REPLACE_WITH_MINIO_SECRET_KEY"
MINIO_SECURE=false
MINIO_BUCKET_NAME="docuspace-documents"

# --- ANTIVIRUS FAIL-CLOSED (CLAMAV) ---
CLAMAV_HOST="clamav"
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=true

# --- CACHE & FILES D'ATTENTE (REDIS) ---
REDIS_URL="redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0"

# --- CORS ---
BACKEND_CORS_ORIGINS=["https://docuspace.example.com","http://localhost:3000"]
